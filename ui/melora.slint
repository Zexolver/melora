import { Button, LineEdit } from "std-widgets.slint";

export struct TabItem {
    id: int,
    title: string,
    url: string,
    active: bool,
    compressed: bool,
}

// Every themeable color in the chrome, in one place. `main.rs` sets all
// of these at startup (from the saved theme choice) and again whenever
// the user picks a different one in the settings panel -- nothing in
// this file hardcodes a palette beyond the defaults below, which exist
// only so the very first frame (before Rust has run) looks right rather
// than unstyled. The rendered *page* is unaffected by any of this --
// only the surrounding browser chrome is themed, the same way a real
// browser's dark mode doesn't repaint the websites you visit.
export global Theme {
    in property <color> bg: #1e1e1e;
    in property <color> chrome: #262626;
    in property <color> chrome-alt: #2d2d2d;
    in property <color> surface-hover: #3a3a3a;
    in property <color> border: #3f3f3f;
    in property <color> text: #f2f2f2;
    in property <color> text-muted: #9a9a9a;
    in property <color> accent: #5b8dee;
}

component TabButton inherits Rectangle {
    in property <TabItem> tab;
    callback select();
    callback close();

    width: 180px;
    height: 32px;
    border-radius: 6px;
    background: tab.active ? Theme.chrome-alt : (touch.has-hover ? Theme.surface-hover : transparent);

    touch := TouchArea {
        clicked => { root.select(); }

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 4px;
            spacing: 4px;

            Text {
                text: tab.compressed ? "\u{1F5DC} " + tab.title : tab.title;
                color: tab.compressed ? Theme.text-muted : Theme.text;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            closeArea := TouchArea {
                width: 16px;
                clicked => { root.close(); }
                Text {
                    text: "\u{2715}";
                    color: closeArea.has-hover ? Theme.text : Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }

        // A thin accent underline on the active tab -- a clearer "you are
        // here" signal than a flat background-color swap alone, and the
        // one place the accent color shows up in the tab strip.
        if tab.active: Rectangle {
            y: parent.height - 2px;
            height: 2px;
            width: parent.width;
            background: Theme.accent;
        }
    }
}

component IconButton inherits Rectangle {
    in property <string> icon;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: area.has-hover ? Theme.surface-hover : transparent;

    area := TouchArea {
        clicked => { root.clicked(); }
        Text {
            text: root.icon;
            color: Theme.text;
            font-size: 15px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component MainWindow inherits Window {
    title: "Melora";
    preferred-width: 1000px;
    preferred-height: 650px;
    background: Theme.bg;

    in property <[TabItem]> tabs;
    in property <string> address-text;
    in property <string> status-text;
    in property <image> page-image;
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    in property <bool> show-restore-prompt: false;
    in property <string> restore-prompt-text;
    in property <bool> show-settings: false;
    in property <string> current-theme: "dark";

    callback new-tab();
    callback close-tab(int);
    callback activate-tab(int);
    callback navigate(string);
    callback go-back();
    callback go-forward();
    callback reload();
    callback scroll(dx: length, dy: length);
    callback click(x: length, y: length, area-width: length, area-height: length);
    callback viewport-resized(width: length, height: length);
    callback restore-session();
    callback discard-session();
    callback hibernate();
    callback open-settings();
    callback close-settings();
    callback set-theme(string);

    VerticalLayout {
        // Tab strip
        Rectangle {
            height: 40px;
            background: Theme.chrome;

            HorizontalLayout {
                padding: 4px;
                spacing: 4px;

                Flickable {
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        spacing: 4px;
                        for tab in root.tabs: TabButton {
                            tab: tab;
                            select => { root.activate-tab(tab.id); }
                            close => { root.close-tab(tab.id); }
                        }
                    }
                }

                IconButton { icon: "+"; clicked => { root.new-tab(); } }
            }
        }

        // Navigation bar
        Rectangle {
            height: 44px;
            background: Theme.chrome-alt;

            HorizontalLayout {
                padding: 6px;
                spacing: 6px;

                Button { text: "<"; enabled: root.can-go-back; clicked => { root.go-back(); } }
                Button { text: ">"; enabled: root.can-go-forward; clicked => { root.go-forward(); } }
                Button { text: "\u{27F3}"; clicked => { root.reload(); } }

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;

                    addressBar := LineEdit {
                        text: root.address-text;
                        accepted(text) => { root.navigate(text); }
                    }
                }

                Button { text: "Go"; clicked => { root.navigate(addressBar.text); } }

                IconButton { icon: "\u{2699}"; clicked => { root.open-settings(); } }

                // Saves every open tab (via whichever hibernation tier it's
                // already in -- RAM-compressed or disk-swapped, see
                // ARCHITECTURE.md) and closes the window. Named Hibernate
                // rather than Quit: closing this way (or any other way --
                // the OS window-close button behaves the same, see
                // main.rs's `on_close_requested` hook) is what lets the
                // next launch restore every tab from its local snapshot,
                // no network refetch involved.
                Button { text: "Hibernate"; clicked => { root.hibernate(); } }
            }
        }

        // Content area: the rasterized page, repainted by main.rs whenever
        // the active tab's content, scroll position, or size changes.
        content := Rectangle {
            vertical-stretch: 1;
            background: white;
            clip: true;

            changed width => { root.viewport-resized(self.width, self.height); }
            changed height => { root.viewport-resized(self.width, self.height); }

            Image {
                source: root.page-image;
                image-fit: fill;
                width: 100%;
                height: 100%;
            }

            contentTouch := TouchArea {
                width: 100%;
                height: 100%;
                scroll-event(event) => {
                    root.scroll(event.delta-x, event.delta-y);
                    accept
                }
                clicked => {
                    root.click(self.mouse-x, self.mouse-y, content.width, content.height);
                }
            }
        }

        // Status bar
        Rectangle {
            height: 22px;
            background: Theme.chrome;
            Text {
                text: root.status-text;
                color: Theme.text-muted;
                font-size: 11px;
                x: 8px;
                vertical-alignment: center;
                height: 100%;
            }
        }
    }

    // Session-restore prompt, shown once at startup when a prior run left
    // tabs residing on disk (see ARCHITECTURE.md). Declared after the main
    // layout so it paints on top of it.
    if root.show-restore-prompt: Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: #000000aa;

        TouchArea {
            // Swallows clicks so they can't fall through to the content
            // behind the overlay while it's up -- unlike the settings
            // panel below, this choice is deliberate: restoring or
            // discarding a session is a decision the user should make
            // explicitly, not dismiss by clicking past it.
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 340px;
            height: 160px;
            background: Theme.chrome-alt;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 18px;
                spacing: 14px;

                Text {
                    text: root.restore-prompt-text;
                    color: Theme.text;
                    font-size: 13px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Button { text: "Restore"; clicked => { root.restore-session(); } }
                    Button { text: "Start Fresh"; clicked => { root.discard-session(); } }
                }
            }
        }
    }

    // Settings panel. Clicking the backdrop closes it (unlike the restore
    // prompt above) since nothing here is a one-time decision that must
    // be made before continuing -- it's just preferences.
    if root.show-settings: Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: #000000aa;

        TouchArea {
            clicked => { root.close-settings(); }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 320px;
            height: 210px;
            background: Theme.chrome-alt;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 18px;
                spacing: 14px;

                Text {
                    text: "Settings";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 600;
                }

                Text {
                    text: "Theme";
                    color: Theme.text-muted;
                    font-size: 12px;
                }

                HorizontalLayout {
                    spacing: 8px;

                    Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        border-width: root.current-theme == "dark" ? 2px : 1px;
                        border-color: root.current-theme == "dark" ? Theme.accent : Theme.border;
                        background: darkArea.has-hover ? Theme.surface-hover : transparent;
                        darkArea := TouchArea {
                            clicked => { root.set-theme("dark"); }
                            Text {
                                text: "Dark";
                                color: Theme.text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        border-width: root.current-theme == "light" ? 2px : 1px;
                        border-color: root.current-theme == "light" ? Theme.accent : Theme.border;
                        background: lightArea.has-hover ? Theme.surface-hover : transparent;
                        lightArea := TouchArea {
                            clicked => { root.set-theme("light"); }
                            Text {
                                text: "Light";
                                color: Theme.text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    Button { text: "Close"; clicked => { root.close-settings(); } }
                }
            }
        }
    }
}
