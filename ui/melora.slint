export struct TabItem {
    id: int,
    title: string,
    url: string,
    active: bool,
    compressed: bool,
}

// Every themeable color in the chrome, in one place. `main.rs` sets all
// of these at startup (from the saved theme choice) and again whenever
// the user picks a different one in the settings panel -- nothing in
// this file hardcodes a palette beyond the defaults below, which exist
// only so the very first frame (before Rust has run) looks right rather
// than unstyled. The rendered *page* is unaffected by any of this --
// only the surrounding browser chrome is themed, the same way a real
// browser's dark mode doesn't repaint the websites you visit.
//
// Refreshed for a more modern-browser feel (closer to Firefox/Brave's
// mobile chrome than the earlier flat, low-contrast palette): a richer
// near-black chrome instead of dark grey, a brighter accent, and
// `accent-soft`/`danger` added for the address bar's focus ring and the
// tab-close hover respectively.
export global Theme {
    in property <color> bg: #131316;
    in property <color> chrome: #1c1c20;
    in property <color> chrome-alt: #232328;
    in property <color> surface-hover: #2e2e35;
    in property <color> border: #35353c;
    in property <color> text: #f4f4f6;
    in property <color> text-muted: #9a9aa4;
    in property <color> accent: #5b8cff;
    in property <color> accent-soft: #5b8cff33;
    in property <color> danger: #ff6b6b;
}

// A pill-shaped tab, matching the rounded, high-contrast active-tab
// styling every mainstream mobile browser (Firefox, Chrome, Brave) uses
// today instead of the flatter, low-radius tab this replaced.
component TabButton inherits Rectangle {
    in property <TabItem> tab;
    callback select();
    callback close();

    width: 190px;
    height: 40px;
    border-radius: self.height / 2;
    background: tab.active ? Theme.accent-soft : (touch.has-hover ? Theme.surface-hover : transparent);
    border-width: tab.active ? 1px : 0px;
    border-color: Theme.accent;

    touch := TouchArea {
        clicked => { root.select(); }

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 8px;
            spacing: 6px;

            Text {
                text: tab.compressed ? "\u{1F5DC} " + tab.title : tab.title;
                color: tab.active ? Theme.text : Theme.text-muted;
                font-size: 13px;
                font-weight: tab.active ? 600 : 400;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            closeArea := TouchArea {
                width: 22px;
                height: 22px;
                clicked => { root.close(); }
                Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: self.width / 2;
                    background: closeArea.has-hover ? Theme.danger : transparent;
                    Text {
                        // Was U+2715 (✕, Dingbats) -- tofu on Android,
                        // same font-coverage gap as the reload icon
                        // below. Unlike reload, this needs to stay a
                        // plain (non-emoji) glyph so `color:` keeps
                        // working -- a colored emoji ignores text color
                        // entirely, which would fight the hover-danger
                        // styling here. U+00D7 (multiplication sign,
                        // Latin-1 Supplement) is a different block from
                        // the arrows/dingbats that failed and virtually
                        // always covered; confirmed live.
                        text: "\u{00D7}";
                        color: closeArea.has-hover ? white : Theme.text-muted;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}

// Three dots built from plain `Rectangle`s rather than a Unicode glyph
// (⋮/⋯/☰ etc.) -- this session found, the hard way, that betting on
// which Unicode block Android's font stack happens to cover is a
// real-live-device-only question (see the reload-icon story below);
// a shape needs no font at all and can't ever be tofu.
component OverflowIcon inherits HorizontalLayout {
    spacing: 3px;
    alignment: center;
    Rectangle { width: 4px; height: 4px; border-radius: 2px; background: Theme.text; }
    Rectangle { width: 4px; height: 4px; border-radius: 2px; background: Theme.text; }
    Rectangle { width: 4px; height: 4px; border-radius: 2px; background: Theme.text; }
}

// Bigger than the 28px it replaced -- 40px meets the ~40-48dp touch
// target real mobile browsers use, and reads as substantially less
// cramped on an actual phone screen than the desktop-scaled original.
component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    callback clicked();

    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: !root.enabled ? transparent : (area.pressed ? Theme.accent-soft : (area.has-hover ? Theme.surface-hover : transparent));

    area := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        Text {
            text: root.icon;
            color: root.enabled ? Theme.text : Theme.text-muted;
            opacity: root.enabled ? 1.0 : 0.4;
            font-size: 17px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// A pill-shaped, filled button for the two primary actions in the nav
// bar (Go, Hibernate) -- flat-text buttons read as desktop-era chrome;
// a filled accent pill is the modern-mobile-browser convention for "the
// one thing you're most likely to tap here".
component PillButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: true;
    callback clicked();

    height: 40px;
    width: label.preferred-width + 28px;
    border-radius: self.height / 2;
    background: root.primary
        ? (area.pressed ? Theme.accent.darker(15%) : Theme.accent)
        : (area.has-hover ? Theme.surface-hover : transparent);
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.border;

    area := TouchArea {
        clicked => { root.clicked(); }
    }

    label := Text {
        text: root.text;
        color: root.primary ? white : Theme.text;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Replaces `std-widgets`' `LineEdit` for the address bar specifically.
// Two things `LineEdit` can't do that this needs: (1) not select-all
// the whole URL the moment it gains focus -- Fennec (old Firefox for
// Android)'s address bar just drops a cursor where you tapped, which
// this matches by explicitly clearing selection on focus-in, since
// `TextInput`'s own default select-on-focus behavior is exactly what
// was asked to change; and (2) a leading URL icon + trailing clear
// button laid out the way every modern browser's address bar actually
// looks, which needs raw control over `TextInput` layout `LineEdit`
// doesn't expose.
component AddressBar inherits Rectangle {
    in property <string> text;
    out property <string> edited-text: text;
    callback navigate(string);

    border-radius: 20px;
    background: Theme.chrome;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    clip: true;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 6px;
        spacing: 6px;

        Text {
            text: "\u{1F310}";
            color: Theme.text-muted;
            font-size: 13px;
            vertical-alignment: center;
        }

        input := TextInput {
            text: root.text;
            horizontal-stretch: 1;
            vertical-alignment: center;
            single-line: true;
            color: Theme.text;
            font-size: 14px;
            edited => { root.edited-text = self.text; }
            accepted => { root.navigate(self.text); }
            changed has-focus => {
                if self.has-focus {
                    self.clear-selection();
                }
            }
        }

        if input.text != "": TouchArea {
            width: 26px;
            clicked => {
                input.text = "";
                root.edited-text = "";
                input.focus();
            }
            Text {
                text: "\u{00D7}";
                color: Theme.text-muted;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Melora";
    preferred-width: 1000px;
    preferred-height: 650px;
    background: Theme.bg;

    in property <[TabItem]> tabs;
    in property <string> address-text;
    in property <string> status-text;
    in property <image> page-image;
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    in property <bool> show-restore-prompt: false;
    in property <string> restore-prompt-text;
    in property <bool> show-settings: false;
    in property <string> current-theme: "dark";
    // Pure UI state (which button, if any, opened it) -- unlike
    // `show-settings` above, Rust never needs to know or drive this, so
    // it isn't an `in property`.
    property <bool> show-overflow-menu: false;

    callback new-tab();
    callback close-tab(int);
    callback activate-tab(int);
    callback navigate(string);
    callback go-back();
    callback go-forward();
    callback reload();
    callback scroll(dx: length, dy: length);
    callback click(x: length, y: length, area-width: length, area-height: length);
    callback viewport-resized(width: length, height: length);
    callback restore-session();
    callback discard-session();
    callback hibernate();
    callback open-settings();
    callback close-settings();
    callback set-theme(string);

    // The single fix for the chrome rendering partly underneath the
    // system status bar's clock/wifi/battery icons on Android:
    // `Window.safe-area-insets` is populated automatically by Slint's
    // Android backend (see `androidwindowadapter.rs`'s
    // `set_window_item_safe_area`) -- desktop's is always zero, so this
    // is a no-op there. Only `.top` matters here since nothing in this
    // layout sits at the left/right/bottom edge of the screen the way
    // the tab strip sits at the top.
    VerticalLayout {
        padding-top: root.safe-area-insets.top;

        // Tab strip
        Rectangle {
            height: 44px;
            background: Theme.chrome;

            HorizontalLayout {
                padding: 4px;
                spacing: 4px;

                Flickable {
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        spacing: 4px;
                        for tab in root.tabs: TabButton {
                            tab: tab;
                            select => { root.activate-tab(tab.id); }
                            close => { root.close-tab(tab.id); }
                        }
                    }
                }

                IconButton { icon: "+"; clicked => { root.new-tab(); } }
            }
        }

        // Navigation bar
        Rectangle {
            height: 52px;
            background: Theme.chrome-alt;
            border-width: 1px;
            border-color: Theme.border;

            HorizontalLayout {
                padding: 6px;
                spacing: 6px;

                IconButton { icon: "\u{2190}"; enabled: root.can-go-back; clicked => { root.go-back(); } }
                IconButton { icon: "\u{2192}"; enabled: root.can-go-forward; clicked => { root.go-forward(); } }
                // Was U+27F3 (⟳); also tried U+21BB, U+21BA, U+27F2,
                // U+2B6E, U+2B6F -- all rendered as tofu boxes on a real
                // Android device/emulator. Confirmed live, by rendering
                // 8 candidates side by side in one build, that the
                // pattern isn't which glyph looks right, it's plane: the
                // BMP "dingbat"/arrow-block symbols above all lack
                // fallback coverage in whatever font Slint's software
                // renderer resolves on Android, while a full emoji
                // (U+1F504, supplementary plane) rendered correctly --
                // real color and all -- because it routes through
                // Android's system emoji font instead. Plain ASCII 'R'
                // also worked, as a fallback data point, but the emoji
                // reads as an actual icon.
                IconButton { icon: "\u{1F504}"; clicked => { root.reload(); } }

                addressBar := AddressBar {
                    horizontal-stretch: 1;
                    text: root.address-text;
                    navigate(t) => { root.navigate(t); }
                }

                PillButton { text: "Go"; clicked => { root.navigate(addressBar.edited-text); } }

                // Settings and Hibernate used to sit here as their own
                // gear-icon/pill buttons -- confirmed live that on an
                // actual phone-width screen, that made the toolbar wider
                // than the display, cutting the Hibernate button off
                // entirely. Collapsed into one overflow menu instead,
                // the same fix every real mobile browser makes for the
                // same reason.
                overflowButton := Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 10px;
                    background: overflowArea.pressed ? Theme.accent-soft : (overflowArea.has-hover ? Theme.surface-hover : transparent);
                    overflowArea := TouchArea {
                        clicked => { root.show-overflow-menu = !root.show-overflow-menu; }
                    }
                    OverflowIcon { }
                }
            }
        }

        // Content area: the rasterized page, repainted by main.rs whenever
        // the active tab's content, scroll position, or size changes.
        content := Rectangle {
            vertical-stretch: 1;
            background: white;
            clip: true;

            changed width => { root.viewport-resized(self.width, self.height); }
            changed height => { root.viewport-resized(self.width, self.height); }

            Image {
                source: root.page-image;
                image-fit: fill;
                width: 100%;
                height: 100%;
            }

            contentTouch := TouchArea {
                width: 100%;
                height: 100%;
                scroll-event(event) => {
                    root.scroll(event.delta-x, event.delta-y);
                    accept
                }
                clicked => {
                    root.click(self.mouse-x, self.mouse-y, content.width, content.height);
                }
            }
        }

        // Status bar
        Rectangle {
            height: 24px;
            background: Theme.chrome;
            Text {
                text: root.status-text;
                color: Theme.text-muted;
                font-size: 11px;
                x: 10px;
                vertical-alignment: center;
                height: 100%;
            }
        }
    }

    // Overflow menu (Settings, Hibernate) -- see the comment at
    // `overflowButton` above for why these two moved off the main
    // toolbar row. A transparent full-window backdrop closes it on any
    // outside tap, same pattern as the settings panel below; anchored
    // to the top-right under the nav bar rather than truly attached to
    // `overflowButton` (Slint doesn't make positioning a popup relative
    // to an arbitrary sibling deep in another layout easy) -- close
    // enough to read as "belongs to that button" without needing exact
    // alignment.
    if root.show-overflow-menu: Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: transparent;

        TouchArea {
            clicked => { root.show-overflow-menu = false; }
        }

        Rectangle {
            x: parent.width - self.width - 10px;
            y: root.safe-area-insets.top + 44px + 52px + 6px;
            width: 170px;
            height: 100px;
            background: Theme.chrome-alt;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-color: #00000066;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 4px;

            VerticalLayout {
                padding: 6px;

                menuSettings := TouchArea {
                    clicked => {
                        root.show-overflow-menu = false;
                        root.open-settings();
                    }
                    Rectangle {
                        height: 44px;
                        border-radius: 8px;
                        background: menuSettings.has-hover ? Theme.surface-hover : transparent;
                        Text {
                            text: "\u{2699} Settings";
                            color: Theme.text;
                            font-size: 14px;
                            x: 14px;
                            vertical-alignment: center;
                            height: 100%;
                        }
                    }
                }

                // See `PillButton { text: "Hibernate"; ... }`'s old doc
                // comment (still just above `overflowButton`) for why
                // this exists and isn't just "Quit".
                menuHibernate := TouchArea {
                    clicked => {
                        root.show-overflow-menu = false;
                        root.hibernate();
                    }
                    Rectangle {
                        height: 44px;
                        border-radius: 8px;
                        background: menuHibernate.has-hover ? Theme.surface-hover : transparent;
                        Text {
                            text: "\u{1F4A4} Hibernate";
                            color: Theme.text;
                            font-size: 14px;
                            x: 14px;
                            vertical-alignment: center;
                            height: 100%;
                        }
                    }
                }
            }
        }
    }

    // Session-restore prompt, shown once at startup when a prior run left
    // tabs residing on disk (see ARCHITECTURE.md). Declared after the main
    // layout so it paints on top of it.
    if root.show-restore-prompt: Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: #000000aa;

        TouchArea {
            // Swallows clicks so they can't fall through to the content
            // behind the overlay while it's up -- unlike the settings
            // panel below, this choice is deliberate: restoring or
            // discarding a session is a decision the user should make
            // explicitly, not dismiss by clicking past it.
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 340px;
            height: 170px;
            background: Theme.chrome-alt;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 20px;
                spacing: 16px;

                Text {
                    text: root.restore-prompt-text;
                    color: Theme.text;
                    font-size: 13px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;
                    PillButton { text: "Restore"; clicked => { root.restore-session(); } }
                    PillButton { text: "Start Fresh"; primary: false; clicked => { root.discard-session(); } }
                }
            }
        }
    }

    // Settings panel. Clicking the backdrop closes it (unlike the restore
    // prompt above) since nothing here is a one-time decision that must
    // be made before continuing -- it's just preferences.
    if root.show-settings: Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: #000000aa;

        TouchArea {
            clicked => { root.close-settings(); }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 320px;
            height: 220px;
            background: Theme.chrome-alt;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                Text {
                    text: "Settings";
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 700;
                }

                Text {
                    text: "Theme";
                    color: Theme.text-muted;
                    font-size: 12px;
                }

                HorizontalLayout {
                    spacing: 10px;

                    Rectangle {
                        height: 40px;
                        border-radius: 10px;
                        border-width: root.current-theme == "dark" ? 2px : 1px;
                        border-color: root.current-theme == "dark" ? Theme.accent : Theme.border;
                        background: darkArea.has-hover ? Theme.surface-hover : transparent;
                        darkArea := TouchArea {
                            clicked => { root.set-theme("dark"); }
                            Text {
                                text: "Dark";
                                color: Theme.text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        height: 40px;
                        border-radius: 10px;
                        border-width: root.current-theme == "light" ? 2px : 1px;
                        border-color: root.current-theme == "light" ? Theme.accent : Theme.border;
                        background: lightArea.has-hover ? Theme.surface-hover : transparent;
                        lightArea := TouchArea {
                            clicked => { root.set-theme("light"); }
                            Text {
                                text: "Light";
                                color: Theme.text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    PillButton { text: "Close"; primary: false; clicked => { root.close-settings(); } }
                }
            }
        }
    }
}
